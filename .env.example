# Neon Postgres (use the pooled connection string from the Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — set NEXTAUTH_URL to your real Vercel URL in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Public site URL for SEO / sitemap (defaults to NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL="https://pulse-sand-alpha.vercel.app"

# Vercel Blob — required for cloud media that survives deploys
# Leave empty for local-only uploads to public/uploads
BLOB_READ_WRITE_TOKEN=""

# Neon Postgres (use the pooled connection string from the Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — set NEXTAUTH_URL to your real Vercel URL in production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Public site URL for SEO / sitemap (defaults to NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL="https://pulse-sand-alpha.vercel.app"

# Vercel Blob — required for cloud media that survives deploys
# Leave empty for local-only uploads to public/uploads
BLOB_READ_WRITE_TOKEN=""

# Sightengine (optional) — better minor+nudity detection if you add keys later.
# Without these, Pulse still blocks sexual images with a built-in NSFW model.
SIGHTENGINE_API_USER=""
SIGHTENGINE_API_SECRET=""

# Stripe — buy Sparks with ILS (₪10 = 100 Sparks). Money goes to YOUR Stripe
# account / bank payouts. Never put card numbers in the Pulse admin UI.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Webhook signing secret for https://YOUR-DOMAIN/api/stripe/webhook
# Listen to: checkout.session.completed
STRIPE_WEBHOOK_SECRET=""

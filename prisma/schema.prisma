generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  handle        String   @unique
  email         String   @unique
  passwordHash  String
  bio           String   @default("")
  avatarUrl     String   @default("")
  sparksBalance Int      @default(0)
  equippedFrame String   @default("")
  equippedBadge String   @default("")
  equippedTitle String   @default("")
  equippedBg    String   @default("")
  isAdmin       Boolean  @default(false)
  banned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  posts          Post[]
  stories        Story[]
  likes          Like[]
  views          View[]
  transactions   Transaction[]
  followers      Follow[]        @relation("Following")
  following      Follow[]        @relation("Follower")
  ownedCosmetics OwnedCosmetic[]
  mapPixels      MapPixel[]
  conversationsA Conversation[]  @relation("UserA")
  conversationsB Conversation[]  @relation("UserB")
  messages       Message[]
  createdEmotes  CustomEmote[]   @relation("EmoteCreator")
  ownedEmotes    OwnedEmote[]
  createdAuctions Auction[]      @relation("AuctionCreator")
  auctionBids    Bid[]
  leadingAuctions Auction[]      @relation("AuctionLeader")
  banRequests    BanRequest[]
  reportsFiled   BanRequest[] @relation("ReportsFiled")
  sparkOrders    SparkOrder[]
  sparkCashouts  SparkCashout[]
  emoteListings  EmoteListing[] @relation("EmoteSeller")
  emotePurchases EmoteListing[] @relation("EmoteBuyer")
}

/// Sparks pack purchase ledger (Lemon Squeezy / demo).
model SparkOrder {
  id           String   @id @default(cuid())
  userId       String
  packId       String
  sparks       Int
  amountAgorot Int // ILS minor units (₪10 = 1000); 0 for free claims
  currency     String   @default("ils")
  /// Payment/claim reference (free_… / Grow processId / Stripe session).
  checkoutId     String   @unique
  provider       String   @default("lemon") // lemon | stripe | demo | free
  status         String   @default("PENDING") // PENDING | PAID | FAILED
  lemonOrderId   String?
  refundedSparks Int      @default(0)
  refundedAgorot Int      @default(0)
  createdAt      DateTime @default(now())
  paidAt         DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashouts SparkCashoutItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Sell Sparks back — refunds the original Lemon / card charge.
model SparkCashout {
  id           String   @id @default(cuid())
  userId       String
  sparks       Int
  amountAgorot Int
  rateAgorot   Int // ILS minor units paid per Spark at sale time
  boostBps     Int      @default(0) // e.g. 1200 = +12%
  reason       String   @default("SPARKS") // SPARKS | EMOTE
  emoteId      String   @default("")
  status       String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt    DateTime @default(now())

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SparkCashoutItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SparkCashoutItem {
  id           String @id @default(cuid())
  cashoutId    String
  sparkOrderId String
  sparks       Int
  amountAgorot Int

  cashout SparkCashout @relation(fields: [cashoutId], references: [id], onDelete: Cascade)
  order   SparkOrder   @relation(fields: [sparkOrderId], references: [id], onDelete: Cascade)

  @@index([sparkOrderId])
}

/// Peer emote sale (Sparks) or house cash-out of a rare emote.
model EmoteListing {
  id          String    @id @default(cuid())
  sellerId    String
  buyerId     String?
  emoteId     String
  ownedEmoteId String
  priceSparks Int
  status      String    @default("OPEN") // OPEN | SOLD | CANCELLED | CASHED
  createdAt   DateTime  @default(now())
  soldAt      DateTime?

  seller User        @relation("EmoteSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User?       @relation("EmoteBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  emote  CustomEmote @relation(fields: [emoteId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([emoteId])
}

/// Flagged content / community report awaiting admin ban decision.
model BanRequest {
  id         String   @id @default(cuid())
  userId     String
  reporterId String?
  reason     String
  note       String   @default("") @db.VarChar(500)
  snippet    String   @default("") @db.VarChar(280)
  source     String // POST | STORY | MESSAGE | PIXEL | BIO | REPORT
  sourceId   String   @default("")
  status     String   @default("PENDING") // PENDING | BANNED | DISMISSED
  createdAt  DateTime @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reporter User? @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([reporterId])
}

model MapPixel {
  id        String   @id @default(cuid())
  index     Int      @unique // 0..999999 on a 1000×1000 grid
  ownerId   String
  color     String
  message   String   @default("") @db.VarChar(140)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Post {
  id           String    @id @default(cuid())
  authorId     String
  type         String // TEXT | IMAGE | CLIP
  body         String    @default("")
  mediaUrl     String    @default("")
  viewsCount   Int       @default(0)
  likesCount   Int       @default(0)
  tipsCount    Int       @default(0)
  boostedUntil DateTime?
  createdAt    DateTime  @default(now())

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  Like[]
  views  View[]
}

model Story {
  id        String   @id @default(cuid())
  authorId  String
  mediaUrl  String
  caption   String   @default("")
  expiresAt DateTime
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model View {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // VIEW_EARN | FOLLOW_EARN | SHOP_SPEND | PIXEL_BUY | ADMIN_REWARD
  meta      String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnedCosmetic {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA    User      @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  kind           String   @default("TEXT") // TEXT | STICKER | IMAGE | VIDEO
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

/// Admin-created custom emote (chat sticker reward from auctions).
model CustomEmote {
  id          String   @id @default(cuid())
  name        String
  glyph       String   @default("✨") // fallback emoji if no image
  description String   @default("")
  imageUrl    String   @default("") // AI image generated from description
  createdById String
  createdAt   DateTime @default(now())

  createdBy User           @relation("EmoteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  auctions  Auction[]
  owners    OwnedEmote[]
  listings  EmoteListing[]

  @@index([createdById])
}

model OwnedEmote {
  id        String   @id @default(cuid())
  userId    String
  emoteId   String
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emote CustomEmote @relation(fields: [emoteId], references: [id], onDelete: Cascade)

  @@unique([userId, emoteId])
}

model Auction {
  id              String   @id @default(cuid())
  emoteId         String
  createdById     String
  startingBid     Int
  currentBid      Int      @default(0)
  currentBidderId String?
  status          String   @default("OPEN") // OPEN | ENDED | CANCELLED
  endsAt          DateTime
  createdAt       DateTime @default(now())

  emote         CustomEmote @relation(fields: [emoteId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("AuctionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  currentBidder User?       @relation("AuctionLeader", fields: [currentBidderId], references: [id], onDelete: SetNull)
  bids          Bid[]

  @@index([status, endsAt])
  @@index([emoteId])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Int
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([bidderId])
}
